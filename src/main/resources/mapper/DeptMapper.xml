<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo2.mapper.DeptMapper">
    <resultMap id="deptMap" type="com.demo2.entity.Dept">
        <id property="deptno" column="deptno"/>
        <result property="dname" column="dname"/>
        <result property="loc" column="loc"/>
    </resultMap>

    <!-- One-to-many: dept -> emp list. e.deptno is aliased to avoid clashing
         with d.deptno; the nested <id> lets MyBatis merge rows per employee. -->
    <resultMap id="deptWithEmpsMap" type="com.demo2.entity.Dept" extends="deptMap">
        <collection property="emps" ofType="com.demo2.entity.Emp">
            <id property="empno" column="empno"/>
            <result property="ename" column="ename"/>
            <result property="job" column="job"/>
            <result property="mgr" column="mgr"/>
            <result property="hiredate" column="hiredate"/>
            <result property="sal" column="sal"/>
            <result property="comm" column="comm"/>
            <result property="deptno" column="emp_deptno"/>
        </collection>
    </resultMap>

    <select id="selectDeptWithEmps" resultMap="deptWithEmpsMap">
        SELECT d.deptno, d.dname, d.loc,
               e.empno, e.ename, e.job, e.mgr, e.hiredate, e.sal, e.comm,
               e.deptno AS emp_deptno
        FROM dept d
        LEFT JOIN emp e ON d.deptno = e.deptno
        WHERE d.deptno = #{deptno}
        ORDER BY e.empno
    </select>
</mapper>
