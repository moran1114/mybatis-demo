<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo2.mapper.EmpMapper">
    <resultMap id="empMap" type="com.demo2.entity.Emp">
        <id property="empno" column="empno"/>
        <result property="ename" column="ename"/>
        <result property="job" column="job"/>
        <result property="mgr" column="mgr"/>
        <result property="hiredate" column="hiredate"/>
        <result property="sal" column="sal"/>
        <result property="comm" column="comm"/>
        <result property="deptno" column="deptno"/>
    </resultMap>

    <resultMap id="empSummaryMap" type="com.demo2.entity.Emp" autoMapping="false">
        <result property="ename" column="ename"/>
        <result property="sal" column="sal"/>
        <result property="deptno" column="deptno"/>
    </resultMap>

    <sql id="empColumns">empno, ename, job, mgr, hiredate, sal, comm, deptno</sql>

    <!-- 1. 鏌ヨ鎵€鏈夊憳宸ョ殑鎵€鏈変俊鎭紙empno, ename, job, mgr, hiredate, sal, comm, deptno锛夈€?-->
    <select id="selectAllEmps" resultMap="empMap">
        select * from emp
    </select>

    <!-- 2. 鏌ヨ鎵€鏈夊憳宸ョ殑濮撳悕 (ename)銆佸伐璧?(sal) 鍜岄儴闂ㄧ紪鍙?(deptno)銆?-->
    <select id="selectNameSalDeptno" resultMap="empSummaryMap">
        select ename,sal,deptno from emp
    </select>

    <!-- 3. 鏌ヨ宸ヨ祫 (sal) 澶т簬 10000 鐨勬墍鏈夊憳宸ヤ俊鎭€?-->
    <select id="selectSalAbove10000" resultMap="empMap">
        select * from emp where sal>10000
    </select>

    <!-- 4. 鏌ヨ閮ㄩ棬缂栧彿 (deptno) 涓?20 鎴?30 鐨勬墍鏈夊憳宸ヤ俊鎭€?-->
    <select id="selectDeptno20Or30" resultMap="empMap">
        select * from emp where deptno = 20 or deptno = 30
    </select>

    <!-- 5. 鏌ヨ鍏ヨ亴鏃ユ湡 (hiredate) 鍦?2001-01-01 涔嬪悗鐨勬墍鏈夊憳宸ヤ俊鎭€?-->
    <select id="selectHiredAfter2001" resultMap="empMap">
        select * from emp where hiredate > '2001-01-01'
    </select>

    <!-- 6. 鏌ヨ濂栭噾 (comm) 涓嶄负 NULL 鐨勬墍鏈夊憳宸ヤ俊鎭€?-->
    <select id="selectWithComm" resultMap="empMap">
        select * from emp where comm is not null
    </select>

    <!-- 7. 鏌ヨ鑱屼綅 (job) 涓?'閿€鍞憳' 鐨勬墍鏈夊憳宸ヤ俊鎭€?-->
    <select id="selectSalespeople" resultMap="empMap">
        select * from emp where job = 'Salesperson'
    </select>

    <!-- 8. 鏌ヨ宸ヨ祫 (sal) 鍦?8000 鍒?20000 涔嬮棿鐨勬墍鏈夊憳宸ヤ俊鎭€?-->
    <select id="selectSalBetween8000And20000" resultMap="empMap">
        select * from emp where sal between 8000 and 20000
    </select>

    <!-- 9. 鏌ヨ娌℃湁濂栭噾 (comm 涓?NULL) 涓斿伐璧?(sal) 灏忎簬 15000 鐨勬墍鏈夊憳宸ヤ俊鎭€?-->
    <select id="selectWithoutCommAndSalBelow15000" resultMap="empMap">
        select * from emp where comm is null and sal&lt;15000
    </select>

    <!-- 10. 鏌ヨ鎵€鏈夊憳宸ヤ俊鎭紝鎸夊伐璧?(sal) 闄嶅簭鎺掑簭銆?-->
    <select id="selectOrderBySalDesc" resultMap="empMap">
        select * from emp order by sal desc
    </select>

    <select id="selectEmpById" resultMap="empMap">
        SELECT <include refid="empColumns"/> FROM emp WHERE empno = #{empno}
    </select>

    <insert id="insertEmp" useGeneratedKeys="true" keyProperty="empno" keyColumn="empno">
        INSERT INTO emp (ename, job, mgr, hiredate, sal, comm, deptno)
        VALUES (#{ename}, #{job}, #{mgr}, #{hiredate}, #{sal}, #{comm}, #{deptno})
    </insert>

    <update id="updateEmp">
        UPDATE emp
        SET ename = #{ename}, job = #{job}, mgr = #{mgr}, hiredate = #{hiredate},
            sal = #{sal}, comm = #{comm}, deptno = #{deptno}
        WHERE empno = #{empno}
    </update>

    <delete id="deleteEmpById">
        DELETE FROM emp WHERE empno = #{empno}
    </delete>

    <!-- where 涓?trim 澶嶇敤鐩稿悓鏉′欢锛岄伩鍏嶄袱浠界瓫閫夐€昏緫鍙戠敓鍋忓樊銆?-->
    <sql id="empConditions">
        <if test="emp != null and emp.ename != null and emp.ename != ''">
            AND ename LIKE CONCAT('%', #{emp.ename}, '%')
        </if>
        <if test="emp != null and emp.job != null and emp.job != ''">
            AND job LIKE CONCAT('%', #{emp.job}, '%')
        </if>
        <if test="emp != null and emp.deptno != null">
            AND deptno = #{emp.deptno}
        </if>
        <if test="emp != null and emp.sal != null">
            AND sal &gt;= #{emp.sal}
        </if>
    </sql>

    <select id="selectByCondition" resultMap="empMap">
        SELECT <include refid="empColumns"/> FROM emp
        <where><include refid="empConditions"/></where>
        ORDER BY sal DESC, empno
    </select>

    <select id="selectByConditionWithTrim" resultMap="empMap">
        SELECT <include refid="empColumns"/> FROM emp
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <include refid="empConditions"/>
        </trim>
        ORDER BY sal DESC, empno
    </select>

    <!-- sort 鏄灇涓撅紱column 鍙兘鏉ヨ嚜鏋氫妇鍐呴瀹氫箟鐨勫垪鍚嶃€?-->
    <select id="selectSorted" resultMap="empMap">
        SELECT <include refid="empColumns"/> FROM emp
        ORDER BY
        <choose>
            <when test="sort != null">${sort.column}</when>
            <otherwise>empno</otherwise>
        </choose>
        DESC
    </select>

    <update id="updatePartial">
        UPDATE emp
        <set>
            <if test="ename != null">ename = #{ename},</if>
            <if test="job != null">job = #{job},</if>
            <if test="mgr != null">mgr = #{mgr},</if>
            <if test="hiredate != null">hiredate = #{hiredate},</if>
            <if test="sal != null">sal = #{sal},</if>
            <if test="comm != null">comm = #{comm},</if>
            <if test="deptno != null">deptno = #{deptno},</if>
        </set>
        WHERE empno = #{empno}
    </update>

    <insert id="insertBatch">
        INSERT INTO emp (ename, job, mgr, hiredate, sal, comm, deptno)
        VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.ename}, #{item.job}, #{item.mgr}, #{item.hiredate},
             #{item.sal}, #{item.comm}, #{item.deptno})
        </foreach>
    </insert>

    <delete id="deleteBatch">
        DELETE FROM emp
        <choose>
            <when test="ids != null and ids.size() > 0">
                WHERE empno IN
                <foreach collection="ids" item="empno" open="(" separator="," close=")">
                    #{empno}
                </foreach>
            </when>
            <otherwise>WHERE 1 = 0</otherwise>
        </choose>
    </delete>

    <select id="selectPreferred" resultMap="empMap">
        SELECT <include refid="empColumns"/> FROM emp
        <where>
            <choose>
                <when test="exactName != null and exactName != ''">
                    ename = #{exactName}
                </when>
                <when test="deptno != null">
                    deptno = #{deptno}
                </when>
                <otherwise>1 = 1</otherwise>
            </choose>
        </where>
        ORDER BY empno
    </select>
</mapper>
