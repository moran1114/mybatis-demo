<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo2.mapper.ProjectMapper">
    <resultMap id="projectMap" type="com.demo2.entity.Project">
        <id property="projectId" column="project_id"/>
        <result property="name" column="project_name"/>
        <result property="startDate" column="start_date"/>
        <result property="budget" column="budget"/>
    </resultMap>

    <!-- Many-to-many: project -> emp_project -> emp. -->
    <resultMap id="projectWithMembersMap" type="com.demo2.entity.Project" extends="projectMap">
        <collection property="members" ofType="com.demo2.entity.Emp">
            <id property="empno" column="empno"/>
            <result property="ename" column="ename"/>
            <result property="job" column="job"/>
            <result property="mgr" column="mgr"/>
            <result property="hiredate" column="hiredate"/>
            <result property="sal" column="sal"/>
            <result property="comm" column="comm"/>
            <result property="deptno" column="deptno"/>
        </collection>
    </resultMap>

    <select id="selectProjectWithMembers" resultMap="projectWithMembersMap">
        SELECT p.project_id, p.name AS project_name, p.start_date, p.budget,
               e.empno, e.ename, e.job, e.mgr, e.hiredate, e.sal, e.comm, e.deptno
        FROM project p
        LEFT JOIN emp_project ep ON p.project_id = ep.project_id
        LEFT JOIN emp e ON ep.empno = e.empno
        WHERE p.project_id = #{projectId}
        ORDER BY e.empno
    </select>
</mapper>
